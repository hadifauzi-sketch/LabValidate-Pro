# ─────────────────────────────────────────────────────────────
# LabValidate Pro — server environment (copy to .env.local, then fill in)
# These are read ONLY inside /api serverless functions. Never exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Turso / libSQL database.
#   1. In the Turso dashboard, click "Create new database" (empty — NOT "Upload SQLite File").
#   2. Open the database → copy its URL (starts with libsql://).
#   3. Create a database Auth Token → copy it.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=paste-your-turso-auth-token-here

# Secret used to sign the login session cookie. Use 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# ── Beta program controls ─────────────────────────────────────
# Comma-separated emails that are ADMIN (unlimited access + admin panel).
ADMIN_EMAILS=hadi.fauzi@gmail.com
# Free trial length (days) before feedback is required.
TRIAL_DAYS=30
# Access length (days) granted when a tester is approved.
ACCESS_DAYS=365
# Require sign-in to use the app (no guest mode) during the beta. true/false.
BETA_REQUIRE_LOGIN=true
# If true, submitting feedback auto-grants the year. If false, the admin
# approves each tester manually after they give feedback.
BETA_AUTO_APPROVE=false
